# --- Rust (.gitignore) ---
/target/
**/*.rs.bk
Cargo.lock

# --- Go (.gitignore) ---
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# go.work

# Misc
.idea
tmp
**/data/db/**

# --- Starlark/Bazel (common) ---
bazel-bin
bazel-out
bazel-testlogs
bazel-workspace
*.pyc

# --- Neovim (General & Plugin specific) ---
.nvimrc
.nvim.lua
*.swp
*.swo
.Session.vim
.netrwhist
/undo/
