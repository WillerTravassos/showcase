# -*- mode: Python -*-
# clinic-scheduler local resources, labelled "clinic-scheduler" in the Tilt UI. The root
# Tiltfile loads this file and enables RESOURCES when clinic-scheduler is the active
# project.
#
# Add workloads from deployments/<service>/overlays/local here as services appear, and
# list every resource name in RESOURCES. k6 tests load from perf-test-runner.tiltfile in
# this folder.

load("../../tilt/lib/Tiltfile", "kustomize_overlay")

LABEL = "clinic-scheduler"
PROJECT_DIR = os.path.join(config.main_dir, "clinic-scheduler")

docker_build(
    "patient-web",
    PROJECT_DIR,
    dockerfile=os.path.join(PROJECT_DIR, "services/patient-web/Dockerfile"),
    only=["go.mod", "go.sum", "internal", "services/patient-web"],
    build_args={"VERSION": str(local("git describe --always --dirty", quiet=True)).strip()},
)
kustomize_overlay(os.path.join(PROJECT_DIR, "deployments/patient-web/overlays/local"))
kustomize_overlay(os.path.join(PROJECT_DIR, "deployments/cilium-gateway/overlays/local"))

# Pods need the CNI (Cilium); spans and logs go to lgtm.
k8s_resource("patient-web", 
    resource_deps=["cilium", "lgtm"],
    port_forwards=[
        "8080:8080"        
    ],
    labels=[LABEL],
)
k8s_resource(
    new_name="cilium-gateway",
    objects=[
        "clinic-scheduler:gateway",
        "patient-localhost-tls:certificate",
        "patient-web:httproute",
        "patient-web-https-redirect:httproute",
    ],
    resource_deps=["cilium-operator", "cilium-envoy", "local-ca", "patient-web"],
    labels=[LABEL],
)

# Healthy pods do not mean Cilium has programmed Envoy; acceptance tests need both.
local_resource(
    "cilium-gateway-programmed",
    cmd="kubectl --namespace clinic-scheduler wait gateway/clinic-scheduler --for=condition=Programmed --timeout=120s",
    resource_deps=["cilium-gateway"],
    labels=[LABEL],
)

RESOURCES = ["patient-web", "cilium-gateway", "cilium-gateway-programmed"]
