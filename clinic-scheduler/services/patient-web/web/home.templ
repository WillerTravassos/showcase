package web

// HomeView is the view model of the patient portal home page, already localized.
type HomeView struct {
	// Lang is the BCP 47 language tag of the page, for example "en".
	Lang string
	// PortalName is the portal's name, used as title and heading.
	PortalName string
	// LanguageSwitch switches the page to the other language.
	LanguageSwitch LanguageSwitchView
}

// Home renders the patient portal home page.
templ Home(v HomeView) {
	<!DOCTYPE html>
	<html lang={ v.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.PortalName }</title>
		</head>
		<body>
			<header>
				@LanguageSwitch(v.LanguageSwitch)
			</header>
			<main>
				<h1>{ v.PortalName }</h1>
			</main>
		</body>
	</html>
}
