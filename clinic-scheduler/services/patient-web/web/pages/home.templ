package pages

import "github.com/WillerTravassos/showcase/clinic-scheduler/services/patient-web/web/components"

// HomeView is the view model of the patient portal home page, already localized.
type HomeView struct {
	Layout components.LayoutView
	// PortalName is the portal's name, used as title and heading.
	PortalName string
}

// Home renders the patient portal home page.
templ Home(v HomeView) {
	@components.Layout(v.Layout) {
		<h1>{ v.PortalName }</h1>
	}
}
